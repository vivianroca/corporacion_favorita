FROM apache/airflow:3.3.2-python3.12
USER root
RUN mkdir -p /opt/lab1/operational /opt/airflow/auth /opt/lab1/inference /opt/lab1/forecast_project && chown -R airflow:root /opt/lab1 /opt/airflow/auth
USER airflow
COPY --chown=airflow:root docker/requirements.forecast.lock /opt/lab1/requirements.forecast.lock
RUN python -m venv /opt/lab1/inference && /opt/lab1/inference/bin/pip install --no-cache-dir --require-hashes -r /opt/lab1/requirements.forecast.lock
COPY --chown=airflow:root src/reposicion /opt/lab1/src/reposicion
COPY --chown=airflow:root src/reposicion /opt/lab1/forecast_project/src/reposicion
COPY --chown=airflow:root configs /opt/lab1/configs
COPY --chown=airflow:root configs /opt/lab1/forecast_project/configs
COPY --chown=airflow:root dags /opt/airflow/dags
COPY --chown=airflow:root docker/init_airflow.py /opt/lab1/init_airflow.py
ENV PYTHONPATH=/opt/lab1/src
ENV LAB1_FORECAST_CONFIG=/opt/lab1/forecast_project/configs/pronostico.yaml
WORKDIR /opt/lab1
