# Extiende la imagen local: añade orquestación Assets y conserva la lógica de negocio.
FROM lab1-airflow:3.3.2
USER root
RUN mkdir -p /opt/lab1/inference /opt/lab1/forecast_project && chown -R airflow:root /opt/lab1/inference /opt/lab1/forecast_project
USER airflow
COPY --chown=airflow:root docker/requirements.forecast.lock /opt/lab1/requirements.forecast.lock
RUN python -m venv /opt/lab1/inference && /opt/lab1/inference/bin/pip install --no-cache-dir --require-hashes -r /opt/lab1/requirements.forecast.lock
COPY --chown=airflow:root src/reposicion /opt/lab1/forecast_project/src/reposicion
COPY --chown=airflow:root configs /opt/lab1/forecast_project/configs
COPY --chown=airflow:root src/reposicion/orchestration.py src/reposicion/airflow_dependencies.py src/reposicion/forecast_clock.py /opt/lab1/src/reposicion/
COPY --chown=airflow:root dags/lab1_ingesta_temporal.py /opt/airflow/dags/lab1_ingesta_temporal.py
COPY --chown=airflow:root dags/lab1_pronostico_reposicion.py /opt/airflow/dags/lab1_pronostico_reposicion.py
COPY --chown=airflow:root dags/lab1_seguimiento.py /opt/airflow/dags/lab1_seguimiento.py
ENV LAB1_FORECAST_CONFIG=/opt/lab1/forecast_project/configs/pronostico.yaml
